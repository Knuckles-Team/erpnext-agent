erpx:feature-attendance a cp:Feature ;
    rdfs:label "Attendance and check-ins" ;
    cp:realizedBy erpx:tool-erpnext_mark_attendance, erpx:tool-erpnext_mark_bulk_attendance, erpx:tool-erpnext_list_attendance, erpx:tool-erpnext_add_employee_checkin, erpx:skill-erpnext-hr, erpx:prompt-hr_manager .

erpx:feature-leaveManagement a cp:Feature ;
    rdfs:label "Leave types, allocations, requests and approval" ;
