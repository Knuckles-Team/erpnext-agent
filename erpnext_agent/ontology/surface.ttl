erpx:tool-erpnext_ingest a cp:Tool ;
    rdfs:label "erpnext_ingest" ;
    cp:componentId "erpnext-mcp/erpnext_ingest" ;
    cp:operatesOn :Customer, :Supplier, :Item, :SalesOrder, :PurchaseOrder, :SalesInvoice, :PurchaseInvoice, :Employee ;
    cp:produces :Customer, :Supplier, :Item, :SalesOrder, :PurchaseOrder, :Invoice, :Employee .

erpx:skill-erpnext-order-to-cash a cp:Skill ;
    rdfs:label "erpnext-order-to-cash" ;
    cp:componentId "erpnext-mcp/skill/erpnext-order-to-cash" ;
    cp:appliesTo :Customer, :Quotation, :SalesOrder, :SalesInvoice, :PaymentEntry .

erpx:skill-erpnext-procure-to-pay a cp:Skill ;
