@prefix : <http://knuckles.team/kg#> .
@prefix cp: <http://knuckles.team/kg/connector-pack#> .
@prefix erpx: <http://knuckles.team/kg/erpnext#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Connector surface of erpnext-mcp in the medulla connector-pack vocabulary:
# the connector, the features it offers, and which typed tool, prompt and
# skill realise each feature, with the domain classes each one acts on. Every
# domain class is declared in erpnext.ttl and rolls up to medulla core there.
# Instances only: this file declares no classes.

erpx:connector a cp:Connector ;
    rdfs:label "erpnext-mcp" ;
    cp:componentId "erpnext-mcp" ;
    cp:providesFeature erpx:feature-orderToCash, erpx:feature-procureToPay, erpx:feature-inventory, erpx:feature-crmPipeline, erpx:feature-projects, erpx:feature-hrBasics, erpx:feature-accountingReports, erpx:feature-schemaDiscovery, erpx:feature-recordMaintenance, erpx:feature-session, erpx:feature-knowledgeGraphIngest .

erpx:feature-orderToCash a cp:Feature ;
    rdfs:label "Order to cash: quote, order, bill and collect from customers" ;
    cp:realizedBy erpx:tool-erpnext_create_document, erpx:tool-erpnext_make_mapped_document, erpx:tool-erpnext_submit_document, erpx:tool-erpnext_cancel_document, erpx:tool-erpnext_get_value, erpx:tool-erpnext_call_method, erpx:tool-erpnext_upload_file, erpx:skill-erpnext-order-to-cash, erpx:prompt-erp_operator .

erpx:feature-procureToPay a cp:Feature ;
    rdfs:label "Procure to pay: book and pay supplier bills" ;
    cp:realizedBy erpx:tool-erpnext_create_document, erpx:tool-erpnext_submit_document, erpx:tool-erpnext_cancel_document, erpx:tool-erpnext_call_method, erpx:tool-erpnext_get_count, erpx:skill-erpnext-procure-to-pay, erpx:prompt-erp_operator .

erpx:feature-inventory a cp:Feature ;
    rdfs:label "Item catalog and stock movements" ;
    cp:realizedBy erpx:tool-erpnext_create_document, erpx:tool-erpnext_submit_document, erpx:tool-erpnext_get_value, erpx:tool-erpnext_run_report, erpx:skill-erpnext-inventory, erpx:prompt-erp_operator .

erpx:feature-crmPipeline a cp:Feature ;
    rdfs:label "Leads and opportunities through to quotation" ;
    cp:realizedBy erpx:tool-erpnext_create_document, erpx:tool-erpnext_make_mapped_document, erpx:tool-erpnext_run_document_method, erpx:tool-erpnext_search_link, erpx:skill-erpnext-crm-pipeline, erpx:prompt-erp_operator .

erpx:feature-projects a cp:Feature ;
    rdfs:label "Projects and tasks" ;
    cp:realizedBy erpx:tool-erpnext_create_document, erpx:tool-erpnext_set_value, erpx:tool-erpnext_get_value, erpx:tool-erpnext_list_documents, erpx:skill-erpnext-projects, erpx:prompt-erp_operator .

erpx:feature-hrBasics a cp:Feature ;
    rdfs:label "Employee master and headcount" ;
    cp:realizedBy erpx:tool-erpnext_create_document, erpx:tool-erpnext_search_link, erpx:tool-erpnext_get_count, erpx:tool-erpnext_set_value, erpx:skill-erpnext-hr, erpx:prompt-erp_operator .

erpx:feature-accountingReports a cp:Feature ;
    rdfs:label "Ledger and financial reports" ;
    cp:realizedBy erpx:tool-erpnext_run_report, erpx:tool-erpnext_list_documents, erpx:skill-erpnext-accounting, erpx:prompt-erp_operator .

erpx:feature-schemaDiscovery a cp:Feature ;
    rdfs:label "DocType schema and record discovery" ;
    cp:realizedBy erpx:tool-erpnext_get_doctype_meta, erpx:tool-erpnext_search_link, erpx:tool-erpnext_list_documents, erpx:tool-erpnext_get_document, erpx:tool-erpnext_get_count, erpx:tool-erpnext_get_version, erpx:prompt-erp_operator .

erpx:feature-recordMaintenance a cp:Feature ;
    rdfs:label "Generic record maintenance on any DocType" ;
    cp:realizedBy erpx:tool-erpnext_update_document, erpx:tool-erpnext_delete_document, erpx:tool-erpnext_rename_document, erpx:tool-erpnext_set_value, erpx:tool-erpnext_run_document_method, erpx:tool-erpnext_call_method, erpx:skill-erpnext-agent-operations, erpx:prompt-erp_operator .

erpx:feature-session a cp:Feature ;
    rdfs:label "Session and identity" ;
    cp:realizedBy erpx:tool-erpnext_login, erpx:tool-erpnext_logout, erpx:tool-erpnext_get_logged_user, erpx:prompt-erp_operator .

erpx:feature-knowledgeGraphIngest a cp:Feature ;
    rdfs:label "Native knowledge-graph ingestion of ERP records" ;
    cp:realizedBy erpx:tool-erpnext_ingest, erpx:prompt-erp_operator .

erpx:tool-erpnext_list_documents a cp:Tool ;
    rdfs:label "erpnext_list_documents" ;
    cp:componentId "erpnext-mcp/erpnext_list_documents" ;
    cp:operatesOn :Customer, :Supplier, :Company, :Item, :Quotation, :SalesOrder, :PurchaseOrder, :SalesInvoice, :PurchaseInvoice, :PaymentEntry, :StockEntry, :StockWarehouse, :LedgerAccount, :GLEntry, :FiscalYear, :Lead, :Opportunity, :Project, :ProjectTask, :Employee, :OrgUnit, :ErpNextIssue .

erpx:tool-erpnext_get_document a cp:Tool ;
    rdfs:label "erpnext_get_document" ;
    cp:componentId "erpnext-mcp/erpnext_get_document" ;
    cp:operatesOn :Customer, :Supplier, :Company, :Item, :Quotation, :SalesOrder, :PurchaseOrder, :SalesInvoice, :PurchaseInvoice, :PaymentEntry, :StockEntry, :StockWarehouse, :LedgerAccount, :GLEntry, :FiscalYear, :Lead, :Opportunity, :Project, :ProjectTask, :Employee, :OrgUnit, :ErpNextIssue .

