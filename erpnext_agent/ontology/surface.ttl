erpx:feature-payroll a cp:Feature ;
    rdfs:label "Salary set-up and payroll runs" ;
    cp:realizedBy erpx:tool-erpnext_create_salary_component, erpx:tool-erpnext_create_salary_structure, erpx:tool-erpnext_assign_salary_structure, erpx:tool-erpnext_create_payroll_entry, erpx:tool-erpnext_fill_payroll_employees, erpx:tool-erpnext_create_salary_slips, erpx:tool-erpnext_submit_salary_slips, erpx:tool-erpnext_list_salary_slips, erpx:tool-erpnext_get_salary_slip, erpx:tool-erpnext_cancel_document, erpx:skill-erpnext-payroll-run, erpx:prompt-hr_manager .

erpx:feature-businessOnboarding a cp:Feature ;
    rdfs:label "Repeatable business onboarding with validation, dry run, apply and verify" ;
    cp:realizedBy erpx:tool-erpnext_get_setup_status, erpx:tool-erpnext_list_timezones, erpx:tool-erpnext_list_chart_of_accounts_templates, erpx:tool-erpnext_plan_business_onboarding, erpx:tool-erpnext_apply_business_onboarding, erpx:tool-erpnext_verify_business_onboarding, erpx:tool-erpnext_complete_setup_wizard, erpx:tool-erpnext_create_company, erpx:tool-erpnext_create_fiscal_year, erpx:tool-erpnext_create_address, erpx:tool-erpnext_create_bank, erpx:tool-erpnext_create_bank_account, erpx:tool-erpnext_set_tax_id, erpx:skill-erpnext-business-onboarding, erpx:prompt-business_onboarding, erpx:prompt-erp_operator .

erpx:feature-accountingReports a cp:Feature ;
    rdfs:label "Ledger and financial reports" ;
    cp:realizedBy erpx:tool-erpnext_run_report, erpx:tool-erpnext_list_documents, erpx:skill-erpnext-accounting, erpx:prompt-erp_operator .

erpx:feature-schemaDiscovery a cp:Feature ;
    rdfs:label "DocType schema and record discovery" ;
