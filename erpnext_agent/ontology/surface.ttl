    cp:operatesOn :Customer, :Supplier, :Company, :Item, :Quotation, :SalesOrder, :PurchaseOrder, :SalesInvoice, :PurchaseInvoice, :PaymentEntry, :StockEntry, :StockWarehouse, :LedgerAccount, :GLEntry, :FiscalYear, :Lead, :Opportunity, :Project, :ProjectTask, :Employee, :OrgUnit, :ErpNextIssue .

