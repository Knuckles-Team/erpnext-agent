@prefix : <http://knuckles.team/kg#> .
@prefix cp: <http://knuckles.team/kg/connector-pack#> .
@prefix erpx: <http://knuckles.team/kg/erpnext#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Connector surface of erpnext-mcp in the medulla connector-pack vocabulary:
# the connector, the features it offers, and which typed tool, prompt and
# skill realise each feature, with the domain classes each one acts on. A
# role prompt (hr_manager, sales_rep, business_onboarding) is linked to its
# skills and tools through the features it realises. Every domain class is
# declared in erpnext.ttl and rolls up to medulla core there.
# Instances only: this file declares no classes.

erpx:connector a cp:Connector ;
    rdfs:label "erpnext-mcp" ;
    cp:componentId "erpnext-mcp" ;
    cp:providesFeature erpx:feature-orderToCash, erpx:feature-procureToPay, erpx:feature-inventory, erpx:feature-crmPipeline, erpx:feature-leadNurturing, erpx:feature-projects, erpx:feature-hrBasics, erpx:feature-hireToRetire, erpx:feature-attendance, erpx:feature-leaveManagement, erpx:feature-payroll, erpx:feature-businessOnboarding, erpx:feature-accountingReports, erpx:feature-schemaDiscovery, erpx:feature-recordMaintenance, erpx:feature-session, erpx:feature-knowledgeGraphIngest .

erpx:feature-orderToCash a cp:Feature ;
    rdfs:label "Order to cash: quote, order, bill and collect from customers" ;
    cp:realizedBy erpx:tool-erpnext_create_document, erpx:tool-erpnext_make_mapped_document, erpx:tool-erpnext_submit_document, erpx:tool-erpnext_cancel_document, erpx:tool-erpnext_amend_document, erpx:tool-erpnext_get_value, erpx:tool-erpnext_call_method, erpx:tool-erpnext_upload_file, erpx:skill-erpnext-order-to-cash, erpx:prompt-erp_operator, erpx:prompt-sales_rep .

erpx:feature-procureToPay a cp:Feature ;
    rdfs:label "Procure to pay: book and pay supplier bills" ;
    cp:realizedBy erpx:tool-erpnext_create_document, erpx:tool-erpnext_submit_document, erpx:tool-erpnext_cancel_document, erpx:tool-erpnext_amend_document, erpx:tool-erpnext_call_method, erpx:tool-erpnext_get_count, erpx:skill-erpnext-procure-to-pay, erpx:prompt-erp_operator .

erpx:feature-inventory a cp:Feature ;
    rdfs:label "Item catalog and stock movements" ;
    cp:realizedBy erpx:tool-erpnext_create_document, erpx:tool-erpnext_submit_document, erpx:tool-erpnext_get_value, erpx:tool-erpnext_run_report, erpx:skill-erpnext-inventory, erpx:prompt-erp_operator .

erpx:feature-crmPipeline a cp:Feature ;
    rdfs:label "Leads and opportunities through sales stages to quotation and customer" ;
    cp:realizedBy erpx:tool-erpnext_create_lead, erpx:tool-erpnext_qualify_lead, erpx:tool-erpnext_create_opportunity_from_lead, erpx:tool-erpnext_update_opportunity_stage, erpx:tool-erpnext_declare_opportunity_lost, erpx:tool-erpnext_create_opportunity_lost_reason, erpx:tool-erpnext_list_opportunities, erpx:tool-erpnext_make_customer_from_lead, erpx:tool-erpnext_make_customer_from_opportunity, erpx:tool-erpnext_create_sales_stage, erpx:tool-erpnext_list_sales_stages, erpx:tool-erpnext_create_opportunity_type, erpx:tool-erpnext_list_opportunity_types, erpx:tool-erpnext_make_mapped_document, erpx:tool-erpnext_search_link, erpx:skill-erpnext-crm-pipeline, erpx:prompt-erp_operator, erpx:prompt-sales_rep .

erpx:feature-leadNurturing a cp:Feature ;
    rdfs:label "Lead nurturing: logged touches, follow-ups and qualification" ;
    cp:realizedBy erpx:tool-erpnext_create_lead, erpx:tool-erpnext_update_lead, erpx:tool-erpnext_qualify_lead, erpx:tool-erpnext_list_leads, erpx:tool-erpnext_log_communication, erpx:tool-erpnext_create_follow_up, erpx:tool-erpnext_list_follow_ups, erpx:tool-erpnext_close_follow_up, erpx:skill-erpnext-lead-nurturing, erpx:prompt-sales_rep .

erpx:feature-projects a cp:Feature ;
    rdfs:label "Projects and tasks" ;
    cp:realizedBy erpx:tool-erpnext_create_document, erpx:tool-erpnext_set_value, erpx:tool-erpnext_get_value, erpx:tool-erpnext_list_documents, erpx:skill-erpnext-projects, erpx:prompt-erp_operator .

erpx:feature-hrBasics a cp:Feature ;
    rdfs:label "HR records, headcount and the HR workflow index" ;
    cp:realizedBy erpx:tool-erpnext_create_employee, erpx:tool-erpnext_get_employee, erpx:tool-erpnext_list_employees, erpx:tool-erpnext_list_departments, erpx:tool-erpnext_list_designations, erpx:tool-erpnext_get_holiday_list, erpx:tool-erpnext_get_count, erpx:tool-erpnext_search_link, erpx:skill-erpnext-hr, erpx:prompt-erp_operator, erpx:prompt-hr_manager .

erpx:feature-hireToRetire a cp:Feature ;
    rdfs:label "Hire to retire: hire, set up, change and exit an employee" ;
