    cp:realizedBy erpx:tool-erpnext_login, erpx:tool-erpnext_logout, erpx:tool-erpnext_get_logged_user, erpx:prompt-erp_operator .

erpx:feature-knowledgeGraphIngest a cp:Feature ;
    rdfs:label "Native knowledge-graph ingestion of ERP records" ;
    cp:realizedBy erpx:tool-erpnext_ingest, erpx:prompt-erp_operator .

