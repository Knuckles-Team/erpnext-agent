@prefix fibo-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix core: <https://knuckles-team.github.io/ontology/core#> .
@prefix fibo-org: <https://spec.edmcouncil.org/fibo/ontology/FND/Organizations/Organizations/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix : <https://knuckles-team.github.io/ontology/connector/erpnext#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ERPNext / Frappe ERP ontology — parties, catalog, sales/purchase orders, invoices and HR.
# All classes and properties live in the shared `:` (kg#) namespace; only the owl:Ontology
# node gets the per-package IRI. Backs the erpnext-agent MCP tool surface (Frappe DocType
# CRUD + the native `erpnext_ingest` KG tool). ERPNext docstatus (read as documentState, see lifecycle.ttl) is 0=Draft, 1=Submitted,
# 2=Cancelled; monetary DocTypes carry grand_total; postings carry posting_date.

# --- classes (owl:Class) ---
# Every class rolls up to a medulla core class by rdfs:subClassOf (never owl:imports).
# :Customer, :Supplier, :Employee, :Company, :PurchaseOrder, :PurchaseInvoice and
# :Opportunity and :ErpNextIssue are core classes themselves (same IRI); the pack only
# labels them.
# Core :Account (brokerage), :Warehouse (data warehouse) and :Task (agent task) mean
# something else, so the ERP ledger account, stock warehouse and project task get
# their own classes below.

:Customer a owl:Class ;
    rdfs:subClassOf core:Customer ;
    rdfs:label "Customer" ;
    rdfs:comment "A party that buys from the company (Frappe Customer doctype)." .

:Supplier a owl:Class ;
    rdfs:subClassOf core:Supplier ;
    rdfs:label "Supplier" ;
    rdfs:comment "A party the company buys from (Frappe Supplier doctype)." .

:Company a owl:Class ;
    rdfs:subClassOf core:Company ;
    rdfs:label "Company" ;
    rdfs:comment "The legal entity whose books a document posts to (Frappe Company doctype)." .

:Item a owl:Class ;
    rdfs:label "Item" ;
    rdfs:comment "A sellable/stockable product or service (Frappe Item doctype)." ;
    rdfs:subClassOf core:SupplyChainItem .

:Quotation a owl:Class ;
    rdfs:label "Quotation" ;
    rdfs:comment "A priced offer to a customer or lead (Frappe Quotation doctype); submittable." ;
    rdfs:subClassOf core:Document .

:SalesOrder a owl:Class ;
    rdfs:label "Sales Order" ;
    rdfs:comment "A confirmed customer order (Frappe Sales Order doctype); submittable." ;
    rdfs:subClassOf core:Order .

:PurchaseOrder a owl:Class ;
    rdfs:subClassOf core:PurchaseOrder ;
    rdfs:label "Purchase Order" ;
    rdfs:comment "A confirmed order placed on a supplier (Frappe Purchase Order doctype)." .

:Invoice a owl:Class ;
    rdfs:label "Invoice" ;
    rdfs:comment "A billing document (Frappe Sales Invoice / Purchase Invoice doctype)." ;
    rdfs:subClassOf core:Document .

:SalesInvoice a owl:Class ;
    rdfs:label "Sales Invoice" ;
    rdfs:comment "An invoice the company issues to a customer; submitting it posts receivable and income GL entries (Frappe Sales Invoice doctype)." ;
    rdfs:subClassOf :Invoice .

:PurchaseInvoice a owl:Class ;
    rdfs:subClassOf core:PurchaseInvoice ;
    rdfs:label "Purchase Invoice" ;
    rdfs:comment "A supplier bill booked against payables (Frappe Purchase Invoice doctype)." .

:PaymentEntry a owl:Class ;
    rdfs:label "Payment Entry" ;
    rdfs:comment "Money received from a customer or paid to a supplier, allocated against invoices (Frappe Payment Entry doctype); submittable." ;
    rdfs:subClassOf core:Document .

:StockEntry a owl:Class ;
    rdfs:label "Stock Entry" ;
    rdfs:comment "A stock movement: material receipt, issue, transfer or manufacture (Frappe Stock Entry doctype); submitting it writes the stock ledger." ;
    rdfs:subClassOf core:Document .

:StockWarehouse a owl:Class ;
    rdfs:label "Stock Warehouse" ;
    rdfs:comment "A physical or logical stock location of a company (Frappe Warehouse doctype)." ;
    rdfs:subClassOf core:DomainEntity .

:LedgerAccount a owl:Class ;
    rdfs:label "Ledger Account" ;
    rdfs:comment "One account of a company's chart of accounts (Frappe Account doctype)." ;
    rdfs:subClassOf core:DomainEntity .

:GLEntry a owl:Class ;
    rdfs:label "GL Entry" ;
    rdfs:comment "One general-ledger posting a submitted document wrote (Frappe GL Entry doctype); read-only." ;
    rdfs:subClassOf core:DomainEntity .

:FiscalYear a owl:Class ;
    rdfs:label "Fiscal Year" ;
    rdfs:comment "An accounting period with start and end dates (Frappe Fiscal Year doctype)." ;
    rdfs:subClassOf core:DomainEntity .

:Lead a owl:Class ;
    rdfs:label "Lead" ;
    rdfs:comment "A prospective customer not yet qualified (Frappe Lead doctype)." ;
    rdfs:subClassOf core:BusinessActor .

:Opportunity a owl:Class ;
    rdfs:subClassOf core:Opportunity ;
    rdfs:label "Opportunity" ;
    rdfs:comment "A qualified sales opportunity from a lead or customer (Frappe Opportunity doctype)." .

:Project a owl:Class ;
    rdfs:label "Project" ;
    rdfs:comment "A body of billable or internal work with tasks and costing (Frappe Project doctype)." ;
    rdfs:subClassOf core:WorkItem .

:ProjectTask a owl:Class ;
    rdfs:label "Project Task" ;
    rdfs:comment "One unit of project work (Frappe Task doctype)." ;
    rdfs:subClassOf core:WorkItem .

:Employee a owl:Class ;
    rdfs:subClassOf core:Employee ;
    rdfs:label "Employee" ;
    rdfs:comment "A person employed by a company (Frappe Employee doctype)." .

:OrgUnit a owl:Class ;
    rdfs:label "Organizational Unit" ;
    rdfs:comment "A department or organizational unit an employee belongs to (Frappe Department doctype)." ;
    rdfs:subClassOf core:Department .

:ErpReport a owl:Class ;
    rdfs:label "ERP Report" ;
    rdfs:comment "A query or script report computed by the ERP (Frappe Report doctype), such as General Ledger or Accounts Receivable." ;
    rdfs:subClassOf core:DomainEntity .

:ErpNextIssue a owl:Class ;
    rdfs:subClassOf core:ErpNextIssue ;
    rdfs:label "ERPNext Issue" ;
    rdfs:comment "A customer support issue (Frappe Issue doctype); core declares it equivalent to :Incident." .

# --- HR, CRM pipeline and onboarding classes (2.5.0) ---

:Designation a owl:Class ;
    rdfs:label "Designation" ;
    rdfs:comment "A job title an employee holds, shared by every company (Frappe Designation doctype)." ;
    rdfs:subClassOf core:DomainEntity .

:HolidayList a owl:Class ;
    rdfs:label "Holiday List" ;
    rdfs:comment "A calendar of holidays and weekly offs that attendance, leave and payroll respect (Frappe Holiday List doctype)." ;
    rdfs:subClassOf core:DomainEntity .

:Attendance a owl:Class ;
    rdfs:label "Attendance" ;
    rdfs:comment "One employee's attendance status for one day (HR app Attendance doctype); submittable." ;
    rdfs:subClassOf core:Event .

:EmployeeCheckin a owl:Class ;
    rdfs:label "Employee Check-in" ;
    rdfs:comment "One check-in or check-out log of an employee (HR app Employee Checkin doctype)." ;
    rdfs:subClassOf core:Event .

:LeaveType a owl:Class ;
    rdfs:label "Leave Type" ;
    rdfs:comment "A kind of leave with its limits: annual, sick, without pay (HR app Leave Type doctype)." ;
    rdfs:subClassOf core:DomainEntity .

:LeaveAllocation a owl:Class ;
    rdfs:label "Leave Allocation" ;
    rdfs:comment "Leave days of a type granted to an employee for a period (HR app Leave Allocation doctype); submittable." ;
    rdfs:subClassOf core:Document .

:LeaveApplication a owl:Class ;
    rdfs:label "Leave Application" ;
    rdfs:comment "An employee's request for leave and the approver's decision (HR app Leave Application doctype); submittable once Approved or Rejected." ;
    rdfs:subClassOf core:Document .

:SalaryComponent a owl:Class ;
    rdfs:label "Salary Component" ;
    rdfs:comment "An earning or deduction line of pay (HR app Salary Component doctype)." ;
    rdfs:subClassOf core:DomainEntity .

:SalaryStructure a owl:Class ;
    rdfs:label "Salary Structure" ;
    rdfs:comment "A pay template of earnings and deductions for a company (HR app Salary Structure doctype); submittable." ;
    rdfs:subClassOf core:Document .

:SalaryStructureAssignment a owl:Class ;
    rdfs:label "Salary Structure Assignment" ;
    rdfs:comment "A salary structure and base pay assigned to an employee from a date (HR app doctype); submittable." ;
    rdfs:subClassOf core:Document .

:PayrollEntry a owl:Class ;
    rdfs:label "Payroll Entry" ;
    rdfs:comment "A company's pay run for one period that creates and submits the salary slips (HR app Payroll Entry doctype); submittable." ;
    rdfs:subClassOf core:PayrollRecord .

:SalarySlip a owl:Class ;
    rdfs:label "Salary Slip" ;
    rdfs:comment "One employee's pay for one period with gross, deductions and net pay (HR app Salary Slip doctype); submittable." ;
    rdfs:subClassOf core:PayrollRecord .

:SalesStage a owl:Class ;
    rdfs:label "Sales Stage" ;
    rdfs:comment "A stage of the sales pipeline an opportunity moves through (Frappe Sales Stage doctype)." ;
    rdfs:subClassOf core:DomainEntity .

:OpportunityType a owl:Class ;
    rdfs:label "Opportunity Type" ;
    rdfs:comment "A kind of opportunity: sales, support, maintenance (Frappe Opportunity Type doctype)." ;
    rdfs:subClassOf core:DomainEntity .

:OpportunityLostReason a owl:Class ;
    rdfs:label "Opportunity Lost Reason" ;
    rdfs:comment "A reason an opportunity was lost (Frappe Opportunity Lost Reason doctype)." ;
    rdfs:subClassOf core:DomainEntity .

:ErpCommunication a owl:Class ;
    rdfs:label "ERP Communication" ;
    rdfs:comment "A logged call, meeting or message about a lead, opportunity or customer (Frappe Communication doctype); a record, not a sent message." ;
    rdfs:subClassOf core:Message .

:FollowUpTodo a owl:Class ;
    rdfs:label "Follow-up ToDo" ;
    rdfs:comment "A dated follow-up assigned to a user about a record (Frappe ToDo doctype)." ;
    rdfs:subClassOf core:WorkItem .

:ErpAddress a owl:Class ;
    rdfs:label "ERP Address" ;
    rdfs:comment "A postal address of the company or a party, linked to it (Frappe Address doctype)." ;
    rdfs:subClassOf core:Place .

:ErpBank a owl:Class ;
    rdfs:label "Bank" ;
    rdfs:comment "A bank the company or a party holds accounts with (Frappe Bank doctype)." ;
    rdfs:subClassOf core:Organization .

:ErpBankAccount a owl:Class ;
    rdfs:label "ERP Bank Account" ;
    rdfs:comment "A bank account of the company or a party; a company account names its ledger (Frappe Bank Account doctype)." ;
    rdfs:subClassOf core:DomainEntity .

# --- links (owl:ObjectProperty) ---

:orderedBy a owl:ObjectProperty ;
    rdfs:label "ordered by" ;
    rdfs:comment "Links a SalesOrder or sales Invoice to the Customer that placed it." ;
    rdfs:domain :SalesOrder ;
    rdfs:range :Customer .

:suppliedBy a owl:ObjectProperty ;
    rdfs:label "supplied by" ;
    rdfs:comment "Links a PurchaseOrder or purchase Invoice to the Supplier fulfilling it." ;
    rdfs:domain :PurchaseOrder ;
    rdfs:range :Supplier .

:contains a owl:ObjectProperty ;
    rdfs:label "contains" ;
    rdfs:comment "Links a SalesOrder, PurchaseOrder, or Invoice to a line Item it includes." ;
    rdfs:range :Item .

:billedOn a owl:ObjectProperty ;
    rdfs:label "billed on" ;
    rdfs:comment "Links an Invoice to the SalesOrder or PurchaseOrder it bills." ;
    rdfs:domain :Invoice .

:placedBy a owl:ObjectProperty ;
    rdfs:label "placed by" ;
    rdfs:comment "Links a sales order to the customer that placed it (alias of :orderedBy)." ;
    rdfs:domain :SalesOrder ;
    rdfs:range :Customer .

:memberOf a owl:ObjectProperty ;
    rdfs:label "member of" ;
    rdfs:comment "Links an employee to the organizational unit they belong to." ;
    rdfs:domain :Employee ;
    rdfs:range :OrgUnit .


:quotedTo a owl:ObjectProperty ;
    rdfs:label "quoted to" ;
    rdfs:comment "Links a Quotation to the Customer or Lead it offers to (party_name)." ;
    rdfs:domain :Quotation .

:fromQuotation a owl:ObjectProperty ;
    rdfs:label "from quotation" ;
    rdfs:comment "Links a SalesOrder to the Quotation it was mapped from (items.prevdoc_docname)." ;
    rdfs:domain :SalesOrder ;
    rdfs:range :Quotation .

:allocatedTo a owl:ObjectProperty ;
    rdfs:label "allocated to" ;
    rdfs:comment "Links a PaymentEntry to an Invoice it settles (references.reference_name)." ;
    rdfs:domain :PaymentEntry ;
    rdfs:range :Invoice .

:postsToAccount a owl:ObjectProperty ;
    rdfs:label "posts to account" ;
    rdfs:comment "Links a GLEntry to the LedgerAccount it debits or credits." ;
    rdfs:domain :GLEntry ;
    rdfs:range :LedgerAccount .

:bookedFor a owl:ObjectProperty ;
    rdfs:label "booked for" ;
    rdfs:comment "Links an ERP document, account or warehouse to the Company whose books it belongs to (company)." ;
    rdfs:range :Company .

:movesItem a owl:ObjectProperty ;
    rdfs:label "moves item" ;
    rdfs:comment "Links a StockEntry to an Item it moves (items.item_code)." ;
    rdfs:domain :StockEntry ;
    rdfs:range :Item .

:targetWarehouse a owl:ObjectProperty ;
    rdfs:label "target warehouse" ;
    rdfs:comment "Links a StockEntry to the StockWarehouse it receives into (items.t_warehouse)." ;
    rdfs:domain :StockEntry ;
    rdfs:range :StockWarehouse .

:convertedFrom a owl:ObjectProperty ;
    rdfs:label "converted from" ;
    rdfs:comment "Links an Opportunity to the Lead it was raised from (party_name when opportunity_from is Lead)." ;
    rdfs:domain :Opportunity ;
    rdfs:range :Lead .

:taskOf a owl:ObjectProperty ;
    rdfs:label "task of" ;
    rdfs:comment "Links a ProjectTask to its Project." ;
    rdfs:domain :ProjectTask ;
    rdfs:range :Project .

:employedBy a owl:ObjectProperty ;
    rdfs:label "employed by" ;
    rdfs:comment "Links an Employee to the Company that employs them." ;
    rdfs:domain :Employee ;
    rdfs:range :Company .

:outstandingAmount a owl:DatatypeProperty ;
    rdfs:label "outstanding amount" ;
    rdfs:comment "Amount of an Invoice still unpaid (outstanding_amount); 0 once fully allocated." ;
    rdfs:range xsd:float .

:designatedAs a owl:ObjectProperty ;
    rdfs:label "designated as" ;
    rdfs:comment "Links an Employee to the Designation (job title) they hold." ;
    rdfs:domain :Employee ;
    rdfs:range :Designation .

:followsHolidayList a owl:ObjectProperty ;
    rdfs:label "follows holiday list" ;
    rdfs:comment "Links an Employee or Company to the HolidayList its attendance and leave respect (holiday_list / default_holiday_list)." ;
    rdfs:range :HolidayList .

:recordedFor a owl:ObjectProperty ;
    rdfs:label "recorded for" ;
    rdfs:comment "Links an Attendance, EmployeeCheckin, LeaveAllocation, LeaveApplication, SalaryStructureAssignment or SalarySlip to the Employee it concerns (employee)." ;
    rdfs:range :Employee .

:ofLeaveType a owl:ObjectProperty ;
    rdfs:label "of leave type" ;
    rdfs:comment "Links a LeaveAllocation or LeaveApplication to its LeaveType." ;
    rdfs:range :LeaveType .

:assignsStructure a owl:ObjectProperty ;
    rdfs:label "assigns structure" ;
    rdfs:comment "Links a SalaryStructureAssignment to the SalaryStructure it assigns." ;
    rdfs:domain :SalaryStructureAssignment ;
    rdfs:range :SalaryStructure .

:hasComponent a owl:ObjectProperty ;
    rdfs:label "has component" ;
    rdfs:comment "Links a SalaryStructure or SalarySlip to a SalaryComponent in its earnings or deductions." ;
    rdfs:range :SalaryComponent .

:paidInRun a owl:ObjectProperty ;
    rdfs:label "paid in run" ;
    rdfs:comment "Links a SalarySlip to the PayrollEntry that created it (payroll_entry)." ;
    rdfs:domain :SalarySlip ;
    rdfs:range :PayrollEntry .

:inSalesStage a owl:ObjectProperty ;
    rdfs:label "in sales stage" ;
    rdfs:comment "Links an Opportunity to its current SalesStage (sales_stage)." ;
    rdfs:domain :Opportunity ;
    rdfs:range :SalesStage .

:ofOpportunityType a owl:ObjectProperty ;
    rdfs:label "of opportunity type" ;
    rdfs:comment "Links an Opportunity to its OpportunityType." ;
    rdfs:domain :Opportunity ;
    rdfs:range :OpportunityType .

:lostBecause a owl:ObjectProperty ;
    rdfs:label "lost because" ;
    rdfs:comment "Links a lost Opportunity to each OpportunityLostReason recorded for it." ;
    rdfs:domain :Opportunity ;
    rdfs:range :OpportunityLostReason .

:aboutRecord a owl:ObjectProperty ;
    rdfs:label "about record" ;
    rdfs:comment "Links an ErpCommunication or FollowUpTodo to the Lead, Opportunity or Customer it is about (reference_doctype / reference_name)." ;
    rdfs:range core:DomainEntity .

:addressOf a owl:ObjectProperty ;
    rdfs:label "address of" ;
    rdfs:comment "Links an ErpAddress to the Company or party it belongs to (links.link_name)." ;
    rdfs:domain :ErpAddress .

:heldAtBank a owl:ObjectProperty ;
    rdfs:label "held at bank" ;
    rdfs:comment "Links an ErpBankAccount to its ErpBank." ;
    rdfs:domain :ErpBankAccount ;
    rdfs:range :ErpBank .

:taxId a owl:DatatypeProperty ;
    rdfs:label "tax ID" ;
    rdfs:comment "Tax, VAT or employer identification number of a Company, Customer or Supplier (tax_id)." ;
    rdfs:range xsd:string .


# --- fields (owl:DatatypeProperty) ---

:grandTotal a owl:DatatypeProperty ;
    rdfs:label "grand total" ;
    rdfs:comment "Rounded document total (grand_total) of a SalesOrder, PurchaseOrder, or Invoice." ;
    rdfs:range xsd:float .

:documentState a owl:DatatypeProperty ;
    rdfs:label "document state" ;
    rdfs:comment "Document lifecycle state derived from Frappe docstatus: Draft (0), Submitted (1) or Cancelled (2)." ;
    rdfs:range xsd:string .

:postingDate a owl:DatatypeProperty ;
    rdfs:label "posting date" ;
    rdfs:comment "Accounting posting/transaction date of an Invoice or order (posting_date / transaction_date)." ;
    rdfs:range xsd:date .

:employeeName a owl:DatatypeProperty ;
    rdfs:label "employee name" ;
    rdfs:domain :Employee ;
    rdfs:range xsd:string .

<https://knuckles-team.github.io/ontology/connector/erpnext> a owl:Ontology ;
    rdfs:label "ERPNext/Frappe ERP Ontology" ;
    rdfs:comment """ERP entities sourced from an ERPNext (Frappe) instance — customers,
suppliers, items, sales and purchase orders, invoices, the CRM pipeline (leads,
opportunities, stages, communications, follow-ups), HR (employees, departments,
designations, holiday lists, attendance, leave, salary and payroll) and the company
set-up (fiscal year, address, bank) — with their relationships, federated into the
scion-sdk knowledge-graph hub over the enterprise layer.""" .

<https://knuckles-team.github.io/ontology/connector/erpnext#firesTransition> a <http://www.w3.org/2002/07/owl#ObjectProperty> ;
    <http://www.w3.org/2000/01/rdf-schema#label> "firesTransition" .
