@prefix : <http://knuckles.team/kg#> .
@prefix vg: <http://knuckles.team/kg/virtual-graph#> .
@prefix erpx: <http://knuckles.team/kg/erpnext#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Data location and federation of erpnext-mcp in the medulla virtual-graph
# vocabulary. ERP records stay in the ERP: medulla reads them live through the
# typed tools (materialisation "virtual"), one mapping per DocType, and ranks
# this source per class. ERPNext is rank 1 (live truth) for the books, stock and
# the parties it bills; rank 2 where a dedicated system may own the class.
# The endpoint is the fleet server name, never a host: the gateway resolves it.
# contentDigest is sha256 over the sorted entity, field and operation lists
# ("entities:", "fields:", "operations:" sections, one value per line).

erpx:source a vg:SourceConnection ;
    rdfs:label "erpnext-mcp" ;
    vg:sourceKind "mcp" ;
    vg:foreignSourceName "erpnext-mcp" ;
    vg:sourceRole "live_truth" ;
    vg:endpointRef [ vg:url "mcp://erpnext-mcp" ] ;
    vg:declaredCapability "read", "write", "submit", "report" .

erpx:contract a vg:MetadataContract ;
    vg:contractSource erpx:source ;
    vg:schemaVersion "1" ;
    vg:contentDigest "sha256:66f666e144726eaee64e69fda4c7a7bfb5573d38f081eac2cb844d86bfdd5540" ;
    vg:discoveredEntity "Account", "Address", "Attendance", "Bank", "Bank Account", "Communication", "Company", "Customer", "Department", "Designation", "Employee", "Employee Checkin", "Fiscal Year", "GL Entry", "Holiday List", "Issue", "Item", "Lead", "Leave Allocation", "Leave Application", "Leave Type", "Opportunity", "Opportunity Lost Reason", "Opportunity Type", "Payment Entry", "Payroll Entry", "Project", "Purchase Invoice", "Purchase Order", "Quotation", "Salary Component", "Salary Slip", "Salary Structure", "Salary Structure Assignment", "Sales Invoice", "Sales Order", "Sales Stage", "Stock Entry", "Supplier", "Task", "ToDo", "Warehouse" ;
    vg:discoveredField "account_name", "address_title", "bank_name", "company_name", "customer_name", "department_name", "description", "designation_name", "employee_name", "holiday_list_name", "item_name", "lead_name", "leave_type_name", "lost_reason", "name", "project_name", "salary_component", "subject", "supplier_name", "title", "voucher_no", "warehouse_name", "year" ;
    vg:discoveredOperation "erpnext_add_employee_checkin", "erpnext_add_holiday_list_weekly_offs", "erpnext_allocate_leave", "erpnext_apply_business_onboarding", "erpnext_apply_leave", "erpnext_approve_leave_application", "erpnext_assign_salary_structure", "erpnext_call_method", "erpnext_cancel_document", "erpnext_close_follow_up", "erpnext_complete_setup_wizard", "erpnext_create_address", "erpnext_create_bank", "erpnext_create_bank_account", "erpnext_create_company", "erpnext_create_department", "erpnext_create_designation", "erpnext_create_document", "erpnext_create_employee", "erpnext_create_fiscal_year", "erpnext_create_follow_up", "erpnext_create_holiday_list", "erpnext_create_lead", "erpnext_create_leave_type", "erpnext_create_opportunity_from_lead", "erpnext_create_opportunity_lost_reason", "erpnext_create_opportunity_type", "erpnext_create_payroll_entry", "erpnext_create_salary_component", "erpnext_create_salary_slips", "erpnext_create_salary_structure", "erpnext_create_sales_stage", "erpnext_declare_opportunity_lost", "erpnext_delete_document", "erpnext_fill_payroll_employees", "erpnext_get_count", "erpnext_get_doctype_meta", "erpnext_get_document", "erpnext_get_employee", "erpnext_get_holiday_list", "erpnext_get_leave_balance", "erpnext_get_logged_user", "erpnext_get_salary_slip", "erpnext_get_setup_status", "erpnext_get_value", "erpnext_get_version", "erpnext_ingest", "erpnext_list_attendance", "erpnext_list_chart_of_accounts_templates", "erpnext_list_departments", "erpnext_list_designations", "erpnext_list_documents", "erpnext_list_employees", "erpnext_list_follow_ups", "erpnext_list_leads", "erpnext_list_opportunities", "erpnext_list_opportunity_types", "erpnext_list_salary_slips", "erpnext_list_sales_stages", "erpnext_list_timezones", "erpnext_log_communication", "erpnext_login", "erpnext_logout", "erpnext_make_customer_from_lead", "erpnext_make_customer_from_opportunity", "erpnext_make_mapped_document", "erpnext_mark_attendance", "erpnext_mark_bulk_attendance", "erpnext_plan_business_onboarding", "erpnext_qualify_lead", "erpnext_reject_leave_application", "erpnext_relieve_employee", "erpnext_rename_document", "erpnext_run_document_method", "erpnext_run_report", "erpnext_search_link", "erpnext_set_tax_id", "erpnext_set_value", "erpnext_submit_document", "erpnext_submit_salary_slips", "erpnext_update_document", "erpnext_update_employee", "erpnext_update_lead", "erpnext_update_opportunity_stage", "erpnext_upload_file", "erpnext_verify_business_onboarding" .

erpx:customerMapping a vg:VirtualMapping ;
    vg:mapsContract erpx:contract ;
    vg:mapsOntologyClass :Customer ;
    vg:mapsEntity "Customer" ;
    vg:keyField "name" ;
    vg:hasPredicateFieldPair erpx:customerLabelPair ;
    vg:approved true .

erpx:customerLabelPair a vg:PredicateFieldPair ;
    vg:predicate rdfs:label ;
    vg:field "customer_name" .

erpx:customerAuthority a vg:SourceAuthority ;
    vg:authoritativeSource erpx:source ;
    vg:authorityFor :Customer ;
    vg:authorityRank 1 ;
    vg:authorityMapping erpx:customerMapping ;
    vg:authorityContract "mcp" ;
    vg:materialisation "virtual" ;
    vg:freshnessMaxAgeSeconds "900"^^xsd:nonNegativeInteger ;
    vg:allowFallback false .

