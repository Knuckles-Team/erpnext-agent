@prefix : <http://knuckles.team/kg#> .
@prefix vg: <http://knuckles.team/kg/virtual-graph#> .
@prefix erpx: <http://knuckles.team/kg/erpnext#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Data location and federation of erpnext-mcp in the medulla virtual-graph
# vocabulary. ERP records stay in the ERP: medulla reads them live through the
# typed tools (materialisation "virtual"), one mapping per DocType, and ranks
# this source per class. ERPNext is rank 1 (live truth) for the books, stock and
# the parties it bills; rank 2 where a dedicated system may own the class.
# The endpoint is the fleet server name, never a host: the gateway resolves it.
# contentDigest is sha256 over the sorted entity, field and operation lists
# ("entities:", "fields:", "operations:" sections, one value per line).

erpx:source a vg:SourceConnection ;
    rdfs:label "erpnext-mcp" ;
    vg:sourceKind "mcp" ;
    vg:foreignSourceName "erpnext-mcp" ;
    vg:sourceRole "live_truth" ;
    vg:endpointRef [ vg:url "mcp://erpnext-mcp" ] ;
    vg:declaredCapability "read", "write", "submit", "report" .

erpx:contract a vg:MetadataContract ;
    vg:contractSource erpx:source ;
    vg:schemaVersion "1" ;
    vg:contentDigest "sha256:687df60bbf8cc612c711124a012887145314b605c453bcba48999b8ba08044a2" ;
    vg:discoveredEntity "Account", "Company", "Customer", "Department", "Employee", "Fiscal Year", "GL Entry", "Issue", "Item", "Lead", "Opportunity", "Payment Entry", "Project", "Purchase Invoice", "Purchase Order", "Quotation", "Sales Invoice", "Sales Order", "Stock Entry", "Supplier", "Task", "Warehouse" ;
    vg:discoveredField "account_name", "company_name", "customer_name", "department_name", "employee_name", "item_name", "lead_name", "name", "project_name", "subject", "supplier_name", "title", "voucher_no", "warehouse_name", "year" ;
    vg:discoveredOperation "erpnext_call_method", "erpnext_cancel_document", "erpnext_create_document", "erpnext_delete_document", "erpnext_get_count", "erpnext_get_doctype_meta", "erpnext_get_document", "erpnext_get_logged_user", "erpnext_get_value", "erpnext_get_version", "erpnext_ingest", "erpnext_list_documents", "erpnext_login", "erpnext_logout", "erpnext_make_mapped_document", "erpnext_rename_document", "erpnext_run_document_method", "erpnext_run_report", "erpnext_search_link", "erpnext_set_value", "erpnext_submit_document", "erpnext_update_document", "erpnext_upload_file" .

erpx:customerMapping a vg:VirtualMapping ;
    vg:mapsContract erpx:contract ;
    vg:mapsOntologyClass :Customer ;
    vg:mapsEntity "Customer" ;
    vg:keyField "name" ;
    vg:hasPredicateFieldPair erpx:customerLabelPair ;
    vg:approved true .

erpx:customerLabelPair a vg:PredicateFieldPair ;
    vg:predicate rdfs:label ;
    vg:field "customer_name" .

erpx:customerAuthority a vg:SourceAuthority ;
    vg:authoritativeSource erpx:source ;
    vg:authorityFor :Customer ;
    vg:authorityRank 1 ;
    vg:authorityMapping erpx:customerMapping ;
    vg:authorityContract "mcp" ;
    vg:materialisation "virtual" ;
    vg:freshnessMaxAgeSeconds "900"^^xsd:nonNegativeInteger ;
    vg:allowFallback false .

