@prefix ac: <https://knuckles-team.github.io/ontology/access#> .
@prefix : <https://knuckles-team.github.io/ontology/connector/erpnext#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Access contracts (SCION-CONNECTOR-CONTROL-R021 / G24): how ERP records are
# answered live through the typed erpnext_list_documents MCP tool (one Frappe
# DocType per contract, filters/fields/limit pushed down), not a copied
# snapshot. Kept apart from erpnext.ttl so the flat access-contract parser
# only reads this file.

:supplierAccess a ac:AccessContract ;
    ac:classIri :Supplier ;
    ac:sourceId "erpnext-agent" ;
    ac:entity "Supplier" ;
    ac:keyField "name" ;
    ac:accessKind "mcp_tool" ;
    ac:operation "erpnext_list_documents" ;
    ac:parameter "doctype", "filters", "fields", "limit_page_length", "limit_start" ;
    ac:pagination "offset" ;
    ac:pushdown "filter", "limit" ;
    ac:authRef "env://ERPNEXT_TOKEN" ;
    ac:rateLimitPerMinute 60 ;
    ac:freshnessSeconds 900 ;
    ac:costHint "low" .

:supplierNameBinding a ac:PropertyBinding ;
    ac:contract :supplierAccess ; ac:property rdfs:label ; ac:field "supplier_name" .

