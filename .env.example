# ==============================================================================
# ERPNext Agent Environment Configuration
# ==============================================================================

# --- MCP Server Settings ---
HOST=0.0.0.0
PORT=8000
TRANSPORT=stdio # options: stdio, streamable-http, sse

# --- Core API / Client Credentials for ERPNext / Frappe ---
# ERPNext / Frappe server endpoint URL (required)
ERPNEXT_URL=
# API token authentication (api_key:api_secret)
ERPNEXT_TOKEN=
# Username / password login (alternative to token auth)
# ERPNEXT_AGENT_USERNAME=
# ERPNEXT_AGENT_PASSWORD=
# TLS verification is mandatory. Select a named runtime profile from AgentConfig.
# TLS_PROFILE=private-pki
# TLS_PROFILES_REF=secret://runtime/tls-profiles

# --- Tool Toggle Switches (set False to disable) ---
AUTHENTICATIONTOOL=True
RESOURCETOOL=True
